#!/usr/bin/env python3
"""Sort herdr spaces (workspaces) alphabetically by label."""
import json, os, socket

SOCK = os.path.expanduser("~/.config/herdr/herdr.sock")

def call(method, params):
    s = socket.socket(socket.AF_UNIX)
    s.connect(SOCK)
    s.sendall((json.dumps({"id": "sort", "method": method, "params": params}) + "\n").encode())
    buf = b""
    while not buf.endswith(b"\n"):
        chunk = s.recv(65536)
        if not chunk:
            break
        buf += chunk
    s.close()
    return json.loads(buf)

ws = call("workspace.list", {})["result"]["workspaces"]
ids = [w["workspace_id"] for w in sorted(ws, key=lambda w: w["label"].lower())]
if ids != [w["workspace_id"] for w in ws]:
    call("workspace.move_block", {"workspace_ids": ids, "before_workspace_id": None})
